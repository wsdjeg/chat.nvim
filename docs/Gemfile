source "https://rubygems.org"

# Modern Jekyll, self-hosted on Cloudflare Pages. The github-pages gem is
# gone: it pinned a Ruby-3-era stack (Jekyll 3.9 / Liquid 4.0.0) that needed
# compat shims for Ruby >= 3.2. Jekyll 4.4 declares csv/webrick itself and
# pulls Liquid 4.0.4+ (bigdecimal + no taint crash), so Ruby 3.4 on
# Cloudflare Pages works out of the box.
gem "jekyll", "~> 4.4"

# Theme, pinned exactly: the rendered site only changes when WE bump this.
# (Pulled from rubygems, so builds do not depend on the GitHub API.)
gem "just-the-docs", "0.12.0", group: :jekyll_plugins

group :jekyll_plugins do
  # Explicitly owned copies of the theme's own runtime deps.
  gem "jekyll-seo-tag", "~> 2.7"
  gem "jekyll-include-cache", "~> 0.2"

  # site.github metadata for seo-tag canonical links.
  gem "jekyll-github-metadata", "~> 2.13"
  gem "jekyll-sitemap", "~> 1.4"

  # docs/tools/index.md links pages with *.md URLs; this rewrites them to
  # the rendered pages. Without it every one of those links 404s.
  gem "jekyll-relative-links", "~> 0.8"

  # Keep the same page-set the old github-pages default plugin set had:
  # pages without front matter still render, page titles fall back to the
  # first heading, README.md (if one ever appears) becomes a dir index.
  gem "jekyll-optional-front-matter", "~> 0.3.2"
  gem "jekyll-readme-index", "~> 0.3"
  gem "jekyll-titles-from-headings", "~> 0.5.3"

  # feed.xml, kept from the github-pages default plugin set.
  gem "jekyll-feed", "~> 0.15"
end

